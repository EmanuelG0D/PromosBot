# --- Telegram (unico dato obligatorio) --------------------------------
# Token que entrega @BotFather al crear el bot:
TELEGRAM_BOT_TOKEN=
# ID del chat o canal destino (empieza con -100 si es canal):
TELEGRAM_CHAT_ID=

# --- eBay (opcional; sin esto la fuente se omite sola) ----------------
# --- Mercado Libre (opcional) -----------------------------------------
# App gratuita en developers.mercadolibre.com
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_SITE=MCO

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Umbrales ---------------------------------------------------------
MIN_DISCOUNT_PCT=40
INSTANT_DISCOUNT_PCT=60
DIGEST_ENABLED=false
DIGEST_EVERY_HOURS=12
DIGEST_MAX_ITEMS=20
VERACITY_WINDOW_DAYS=30
VERACITY_MIN_DAYS=7
HIKE_PCT=10
FLASH_WINDOW_HOURS=48
FLASH_MIN_DISCOUNT_PCT=20
VERACITY_MIN_DROP_PCT=5
SUPPRESS_FAKE_DISCOUNTS=true
SEED_ON_EMPTY_DB=true
SEED_MAX_ALERTS=5
GLITCH_DISCOUNT_PCT=75
MAX_ALERTS_PER_RUN=8
MAX_ALERTS_PER_DAY=40
REALERT_DROP_PCT=10
REALERT_DAYS=14

# Exigir historial propio antes de marcar algo como error de precio.
# Ponlo en true si el canal se llena de falsos positivos de marketplace.
REQUIRE_HISTORY_FOR_GLITCH=false

# --- Costo puesto en Colombia ----------------------------------------
FREIGHT_USD_PER_LB=4.0
FREIGHT_MIN_USD=6.0
DEFAULT_WEIGHT_LB=2.0
DUTY_FREE_LIMIT_USD=200
IVA_PCT=19
TARIFF_PCT=10

# --- Despliegue en Render --------------------------------------------
# PORT lo inyecta Render solo; no hay que ponerlo.
RUN_EVERY_MINUTES=15
# Protege el disparador manual /run (opcional pero recomendado)
RUN_TOKEN=

# --- Persistencia del historial --------------------------------------
# Render borra el disco en cada despliegue. Con esto el historial se guarda
# en tu propio repositorio y sobrevive a reinicios.
GITHUB_TOKEN=
GITHUB_REPO=usuario/repositorio
GITHUB_BRANCH=main
GITHUB_STATE_PATH=estado/radar.db
